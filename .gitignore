.DS_Store
*.swp
.idea/
__pycache__/
*.pyc
# claude plugin eval output
plugins/*/evals/results/
# session transcripts a replay run writes beside the history it resumes
plugins/*/evals/**/[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*.jsonl
# eval-only fixture plugin (declares a mock MCP server); build_history.py regenerates it.
# Kept out of the tree so the shipped plugin carries no nested plugin.json or .mcp.json.
plugins/*/evals/**/session-tools/
# types the engine lays beside a mod it loads from a dev folder; regenerated per build
plugins/*/.claude-plugin/types/
