{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Skill|mcp__ccd_session_mgmt__set_session_title",
        "hooks": [{ "type": "command", "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__ccd_session_mgmt__set_session_title",
        "hooks": [{ "type": "command", "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "[ -d \"${CLAUDE_PROJECT_DIR:-.}/aidlc/spaces\" ] || [ -d ./aidlc/spaces ] || exit 0; command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_titles.py\"" }] }
    ]
  }
}
